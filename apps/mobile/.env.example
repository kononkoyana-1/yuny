# Which repository implementation the app uses (TZ.md §6 "Mock-first").
#   mock     — realistic in-memory data, no network, no sign-in
#   supabase — the real backend; the app is gated behind sign-in
EXPO_PUBLIC_DATA_SOURCE=mock

# Public by design: the publishable key grants nothing on its own, every
# table is behind RLS. Required when EXPO_PUBLIC_DATA_SOURCE=supabase.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Set to `enabled` once a Google client is configured in the Supabase
# dashboard (Authentication → Sign In / Providers → Google). Until then the
# "Continue with Google" button stays hidden rather than failing on tap.
# Sign in with Apple needs no flag — it shows on iOS only, where the native
# sheet exists.
EXPO_PUBLIC_GOOGLE_SIGN_IN=disabled
